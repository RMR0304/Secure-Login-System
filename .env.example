# ==============================================================================
# ENVIRONMENT CONFIGURATION: SECURE PASSWORD STORAGE CAMPUS PORTAL
# ==============================================================================

# Application Environment: development | production | testing
APP_ENV=development

# Database connection URL (SQLite local database)
DATABASE_URL=sqlite:///./data/secure_password_storage.db

# Cryptographic secret for session signing and internal state integrity
# IMPORTANT: Replace with a cryptographically secure random string in production
SESSION_SECRET=dev-session-key-must-be-at-least-32-chars-long-sec-rnd-val

# Session expiration duration in minutes
SESSION_EXPIRE_MINUTES=30

# Account Lockout Policy
# Maximum consecutive failed login attempts before account lockout occurs
LOCKOUT_MAX_ATTEMPTS=5
# Lockout cooldown period in minutes
LOCKOUT_DURATION_MINUTES=15

# Password Recovery Policy
# Recovery token validity period in minutes
RECOVERY_TOKEN_EXPIRE_MINUTES=10

# Cookie Security Flags
# Set to 'true' in production with HTTPS. Set to 'false' for local HTTP development.
COOKIE_SECURE=false

# Argon2id Derivation Parameters (RFC 9106 recommended profile)
# time_cost (t): Number of passes / iterations over memory
ARGON2_TIME_COST=2
# memory_cost (m): Memory usage in KiB (65536 KiB = 64 MiB)
ARGON2_MEMORY_COST=65536
# parallelism (p): Number of concurrent threads/lanes
ARGON2_PARALLELISM=2
